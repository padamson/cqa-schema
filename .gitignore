output/
site/
book/build/

# scripts/dev.sh writes its own PID here to stop a prior loop on relaunch.
.dev.pid

# Regenerated by `mdbook-listings install` / `mdbook-admonish install` /
# `mdbook-panschema install` (see scripts/install-assets.sh)
book/mdbook-listings.css
book/mdbook-listings.js
book/mdbook-admonish.css
book/schema-link.css
book/schema-link.js

# Throwaway pre-template build kept as a reference target (see CLAUDE.md).
spike/

# Agent skills, fetched by `npx skills add` and pinned in skills-lock.json
# (committed), so not vendored here. With `-a claude-code` the CLI writes
# each skill as a directory under .claude/skills/; other agent targets
# write a hub under .agents/ and symlink it, so both are ignored. A skill
# authored in this repo would need a `!` negation here.
/.agents/skills/
/.claude/skills/
